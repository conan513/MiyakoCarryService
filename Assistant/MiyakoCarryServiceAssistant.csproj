<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <DevGamePath>D:\OtherGames\SPT4.1.X\SPT-4.1.X</DevGamePath>
    <DevHeadlessGamePath>D:\OtherGames\SPT4.1.X\SPT-4.1.X-Headless</DevHeadlessGamePath>
    <DevGamePluginsMcsPath>$(DevGamePath)\BepInEx\plugins\MiyakoCarryServiceClient</DevGamePluginsMcsPath>
    <DevGameScriptsMcsPath>$(DevGamePath)\BepInEx\scripts</DevGameScriptsMcsPath>
    <DevHeadlessGamePluginsMcsPath>$(DevHeadlessGamePath)\BepInEx\plugins\MiyakoCarryServiceClient</DevHeadlessGamePluginsMcsPath>
    <BuildMcsPath>$(ProjectDir)../Build/Assistant/BepInEx/plugins/MiyakoCarryServiceClient</BuildMcsPath>
    <BuildServerAddonPath>$(ProjectDir)../Build/Assistant/SPT_Runtime/user/mods/MiyakoCarryServiceServer/Assets/database/locales/addon</BuildServerAddonPath>
    <DevServerAddonPath>$(DevGamePath)\SPT_Runtime\user\mods\MiyakoCarryServiceServer\Assets\database\locales\addon</DevServerAddonPath>
    <AssemblyName>Himesamanoyume.MiyakoCarryServiceAssistant</AssemblyName>
    <AssemblyCompany>Himesamanoyume</AssemblyCompany>
    <AssemblyProduct>MiyakoCarryServiceAssistant</AssemblyProduct>
    <AssemblyCopyright>Copyright © 姫様の夢 2025 - 2026</AssemblyCopyright>
    <Version>1.1.3.1</Version>
    <AssemblyTitle>MiyakoCarryServiceAssistant</AssemblyTitle>
    <Trademark>https://sp-mod.com/mod/2709/miyako-carry-service</Trademark>
    <RootNamespace>MiyakoCarryService.Assistant</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="../Ref/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="../Ref/Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="../Ref/BepInEx.dll" Private="false" />
    <Reference Include="Comfort" HintPath="../Ref/Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="../Ref/Comfort.Unity.dll" Private="false" />
    <Reference Include="CommonExtensions" HintPath="../Ref/CommonExtensions.dll" Private="false" />
    <Reference Include="ConfigurationManager" HintPath="../Ref/ConfigurationManager.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="../Ref/DissonanceVoip.dll" Private="false" />
    <Reference Include="DrakiaXYZ-BigBrain" HintPath="../Ref/DrakiaXYZ-BigBrain.dll" Private="false" />
    <Reference Include="ItemComponent.Types" HintPath="../Ref/ItemComponent.Types.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="../Ref/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="../Ref/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="spt-common" HintPath="../Ref/spt-common.dll" Private="false" />
    <Reference Include="spt-core" HintPath="../Ref/spt-core.dll" Private="false" />
    <Reference Include="spt-custom" HintPath="../Ref/spt-custom.dll" Private="false" />
    <Reference Include="spt-debugging" HintPath="../Ref/spt-debugging.dll" Private="false" />
    <Reference Include="spt-reflection" HintPath="../Ref/spt-reflection.dll" Private="false" />
    <Reference Include="spt-singleplayer" HintPath="../Ref/spt-singleplayer.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="../Ref/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="../Ref/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="../Ref/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="../Ref/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="../Ref/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="../Ref/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="../Ref/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="../Ref/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="../Ref/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="../Ref/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="../Ref/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Client/MiyakoCarryServiceClient.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <AssistantAddonAssets Include="$(ProjectDir)Assets\database\locales\addon\**\*.*" />
    </ItemGroup>
    <!-- Debug 构建 -->
    <Delete Files="$(DevGamePluginsMcsPath)\$(TargetFileName);$(DevGamePluginsMcsPath)\$(TargetName).pdb" Condition="'$(Configuration)' == 'Debug' and Exists('$(DevGamePluginsMcsPath)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevGameScriptsMcsPath)" Condition="'$(Configuration)' == 'Debug' and Exists('$(DevGameScriptsMcsPath)')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DevGameScriptsMcsPath)" Condition="'$(Configuration)' == 'Debug' and Exists('$(TargetDir)$(TargetName).pdb') and Exists('$(DevGameScriptsMcsPath)')" />

    <!-- Release 构建 -->
    <Delete Files="$(DevGameScriptsMcsPath)\$(TargetFileName);$(DevGameScriptsMcsPath)\$(TargetName).pdb" Condition="'$(Configuration)' == 'Release' and Exists('$(DevGameScriptsMcsPath)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevGamePluginsMcsPath)" Condition="'$(Configuration)' == 'Release' and Exists('$(DevGamePluginsMcsPath)')" />

    <!-- 共通 -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevHeadlessGamePluginsMcsPath)" Condition="Exists('$(DevHeadlessGamePath)')" />
    <MakeDir Directories="$(BuildMcsPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BuildMcsPath)" />

    <!-- 服务端 addon 本地化：助手扩展的本地化部署到 MiyakoCarryServiceServer 的 addon 目录 -->
    <MakeDir Directories="$(BuildServerAddonPath)" />
    <Copy SourceFiles="@(AssistantAddonAssets)" DestinationFiles="@(AssistantAddonAssets->'$(BuildServerAddonPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AssistantAddonAssets)" DestinationFiles="@(AssistantAddonAssets->'$(DevServerAddonPath)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(DevGamePath)')" />
  </Target>
</Project>